From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:57:42 +0300
Subject: [PATCH 5/5] include: make roamingProtocol in RIL_InitialAttachApn
 optional

Some MediaTek vendor RILs have no roamingProtocol member in
RIL_InitialAttachApn; with it every later field is shifted by one
pointer. libril builds for those RILs define
MTK_RIL_IAA_NO_ROAMING_PROTOCOL.
---
 include/telephony/ril.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/include/telephony/ril.h b/include/telephony/ril.h
index bbb4af8..70b539b 100644
--- a/include/telephony/ril.h
+++ b/include/telephony/ril.h
@@ -6495,6 +6495,12 @@ typedef struct {
     char *apn;		  /* the APN to connect to */
     char *protocol;	     /* one of the PDP_type values in TS 27.007 section 10.1.1 used on
 				   roaming network. For example, "IP", "IPV6", "IPV4V6", or "PPP".*/
+#ifndef MTK_RIL_IAA_NO_ROAMING_PROTOCOL
+    char *roamingProtocol;    /* PDP_type used on the roaming network. Present in
+                                   some MTK vendor RILs only; the others build
+                                   libril with -DMTK_RIL_IAA_NO_ROAMING_PROTOCOL
+                                   (ril/libril/Android.mk). */
+#endif
     int authtype;	       /* authentication protocol used for this PDP context
 				   (None: 0, PAP: 1, CHAP: 2, PAP&CHAP: 3) */
     char *username;	     /* the username for APN, or NULL */
