From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:57:42 +0300
Subject: [PATCH 3/8] bluetooth: h4: send the packet type and payload in one
 write

MediaTek's /dev/stpbt has .write but no .write_iter, so writev() falls
back to one write per iovec and each write becomes one STP packet. The
controller gets the H4 type byte and the HCI packet separately, acks
neither, and STP resets the link. Build the packet in one buffer and
write it at once.
---
 bluetooth/1.0/default/h4_protocol.cc | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/bluetooth/1.0/default/h4_protocol.cc b/bluetooth/1.0/default/h4_protocol.cc
index df40507..ba66b36 100644
--- a/bluetooth/1.0/default/h4_protocol.cc
+++ b/bluetooth/1.0/default/h4_protocol.cc
@@ -22,6 +22,7 @@
 #include <fcntl.h>
 #include <log/log.h>
 #include <sys/uio.h>
+#include <vector>
 #include <unistd.h>
 
 namespace android {
@@ -30,11 +31,17 @@ namespace bluetooth {
 namespace hci {
 
 size_t H4Protocol::Send(uint8_t type, const uint8_t* data, size_t length) {
-  struct iovec iov[] = {{&type, sizeof(type)},
-                        {const_cast<uint8_t*>(data), length}};
+  /* One write() per packet: MediaTek's /dev/stpbt turns every write into
+   * one STP packet, so a writev() of type byte and payload reaches the
+   * controller as two broken packets. */
+  std::vector<uint8_t> packet;
+  packet.reserve(length + 1);
+  packet.push_back(type);
+  packet.insert(packet.end(), data, data + length);
+
   ssize_t ret = 0;
   do {
-    ret = TEMP_FAILURE_RETRY(writev(uart_fd_, iov, sizeof(iov) / sizeof(iov[0])));
+    ret = TEMP_FAILURE_RETRY(write(uart_fd_, packet.data(), packet.size()));
   } while (-1 == ret && EAGAIN == errno);
 
   if (ret == -1) {
