From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:57:42 +0300
Subject: [PATCH 4/8] gnss: copy NMEA sentences into the HIDL string

setToExternal() makes writeEmbeddedToParcel() send length + 1 bytes
straight from the HAL buffer. The MediaTek GPS HAL does not
NUL-terminate at nmea[length], so the reader rejects the string
("Received unterminated hidl_string buffer") and the sentence never
reaches the framework. Copy it; the copy is NUL-terminated.
---
 gnss/1.0/default/Gnss.cpp | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/gnss/1.0/default/Gnss.cpp b/gnss/1.0/default/Gnss.cpp
index 32c131c..c67d040 100644
--- a/gnss/1.0/default/Gnss.cpp
+++ b/gnss/1.0/default/Gnss.cpp
@@ -19,6 +19,8 @@
 #include "Gnss.h"
 #include <GnssUtils.h>
 
+#include <string.h>
+
 namespace android {
 namespace hardware {
 namespace gnss {
@@ -260,8 +262,16 @@ void Gnss::nmeaCb(GpsUtcTime timestamp, const char* nmea, int length) {
         return;
     }
 
-    android::hardware::hidl_string nmeaString;
-    nmeaString.setToExternal(nmea, length);
+    if (nmea == nullptr || length < 0) {
+        ALOGE("%s: invalid NMEA buffer (%p, %d)", __func__, nmea, length);
+        return;
+    }
+    // Copy the sentence. setToExternal() would make writeEmbeddedToParcel()
+    // send length+1 bytes straight from the vendor buffer, and the MTK HAL
+    // does not NUL-terminate at nmea[length]; the reader then rejects the
+    // string ("Received unterminated hidl_string buffer") and the sentence
+    // never reaches the framework. The copy NUL-terminates.
+    android::hardware::hidl_string nmeaString(nmea, strnlen(nmea, length));
     auto ret = sGnssCbIface->gnssNmeaCb(timestamp, nmeaString);
     if (!ret.isOk()) {
         ALOGE("%s: Unable to invoke callback", __func__);
