From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:57:42 +0300
Subject: [PATCH 5/8] hwc2on1adapter: no acquire fence for an unused client
 target

When every layer is device-composited, the HWC1 device does not read the
framebuffer target, and mClientTarget still holds a signalled fence from
the last GLES frame. A dup of it was handed over anyway. MediaTek HWC 1.x
blobs do not close the acquire fence of a layer they never read, so the
composer leaked one fd per frame until it ran out. Pass -1 instead.
---
 .../2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp      | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp b/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp
index 6551a99..dfad0fe 100644
--- a/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp
+++ b/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp
@@ -1282,9 +1282,11 @@ Error HWC2On1Adapter::Display::set(hwc_display_contents_1& hwcContents) {
 
     // Close acquire fences on FRAMEBUFFER layers, since they will not be used
     // by HWC
+    bool hasClientLayers = false;
     for (size_t l = 0; l < numLayers - 1; ++l) {
         auto& layer = hwcContents.hwLayers[l];
         if (layer.compositionType == HWC_FRAMEBUFFER) {
+            hasClientLayers = true;
             ALOGV("Closing fence %d for layer %zd", layer.acquireFenceFd, l);
             close(layer.acquireFenceFd);
             layer.acquireFenceFd = -1;
@@ -1294,7 +1296,15 @@ Error HWC2On1Adapter::Display::set(hwc_display_contents_1& hwcContents) {
     auto& clientTargetLayer = hwcContents.hwLayers[numLayers - 1];
     if (clientTargetLayer.compositionType == HWC_FRAMEBUFFER_TARGET) {
         clientTargetLayer.handle = mClientTarget.getBuffer();
-        clientTargetLayer.acquireFenceFd = mClientTarget.getFence();
+        if (hasClientLayers) {
+            clientTargetLayer.acquireFenceFd = mClientTarget.getFence();
+        } else {
+            // With every layer composited by the device the client target is
+            // not read, and its fence is a stale one from the last GLES frame.
+            // Some HWC1 devices never close the acquire fence of an unread
+            // target, which leaks one fd per frame; it needs no fence.
+            clientTargetLayer.acquireFenceFd = -1;
+        }
     } else {
         ALOGE("[%" PRIu64 "] set: last HWC layer wasn't FRAMEBUFFER_TARGET",
                 mId);
