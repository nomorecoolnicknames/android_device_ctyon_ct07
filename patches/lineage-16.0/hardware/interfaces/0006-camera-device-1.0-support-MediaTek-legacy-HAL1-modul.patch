diff --git a/camera/device/1.0/default/CameraDevice_1_0.h b/camera/device/1.0/default/CameraDevice_1_0.h
index 2b35a73..0af6db6 100644
--- a/camera/device/1.0/default/CameraDevice_1_0.h
+++ b/camera/device/1.0/default/CameraDevice_1_0.h
@@ -18,6 +18,7 @@
 #define ANDROID_HARDWARE_CAMERA_DEVICE_V1_0_CAMERADEVICE_H
 
 #include <unordered_map>
+#include <nativebase/nativebase.h>
 #include "utils/Mutex.h"
 #include "utils/SortedVector.h"
 #include "CameraModule.h"
@@ -152,10 +153,28 @@ private:
         // Called when we expect buffer will be re-allocated
         void cleanUpCirculatingBuffers();
 
+        // MediaTek's legacy HAL1 treats the buffer_handle_t* from
+        // dequeue_buffer as &ANativeWindowBuffer::handle, as the pre-O
+        // framework returned it, and calls incRef/decRef through the
+        // enclosing ANativeWindowBuffer. Keep each handle inside a real one;
+        // the map owns the buffers, so the refcount hooks do nothing.
+        struct CirculatingBuffer : public ANativeWindowBuffer {
+            CirculatingBuffer() {
+                common.incRef = sRefHook;
+                common.decRef = sRefHook;
+            }
+            static void sRefHook(struct android_native_base_t*) {}
+        };
+
         Mutex mLock;
         sp<ICameraDevicePreviewCallback> mPreviewCallback = nullptr;
-        std::unordered_map<uint64_t, buffer_handle_t> mCirculatingBuffers;
+        std::unordered_map<uint64_t, CirculatingBuffer> mCirculatingBuffers;
         std::unordered_map<buffer_handle_t*, uint64_t> mBufferIdMap;
+        // Preview geometry, kept for the embedded ANativeWindowBuffer.
+        int mPreviewWidth = 0;
+        int mPreviewHeight = 0;
+        int mPreviewFormat = 0;
+        int mPreviewUsage = 0;
     } mHalPreviewWindow;
 
     // gating access to mDevice, mInitFail, mDisconnected
@@ -196,6 +215,11 @@ private:
