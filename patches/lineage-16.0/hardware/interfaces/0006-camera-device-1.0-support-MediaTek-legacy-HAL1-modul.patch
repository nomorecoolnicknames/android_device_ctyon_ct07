+static_assert(offsetof(ANativeWindowBuffer, common.incRef) == 24,
+        "MTK HAL1 expects incRef at +24");
+static_assert(offsetof(ANativeWindowBuffer, common.decRef) == 28,
+        "MTK HAL1 expects decRef at +28");
+#endif
+
