From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:57:42 +0300
Subject: [PATCH 1/8] audio: skip get_capture_position for legacy HALs that
 leave it unset

Some MediaTek audio HALs built for older releases never assign
audio_stream_in::get_capture_position. The slot holds uninitialised heap
memory, so it is not NULL, and the service crashes (SIGSEGV with the PC in
the heap) on every microphone capture. With
ro.audio.legacy_hal_no_capture_position=1 the call is skipped and
NOT_SUPPORTED returned; only AudioRecord position reporting is lost.
Off by default.
---
 .../include/core/all-versions/default/StreamIn.impl.h      | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/audio/core/all-versions/default/include/core/all-versions/default/StreamIn.impl.h b/audio/core/all-versions/default/include/core/all-versions/default/StreamIn.impl.h
index adad331..ab94009 100644
--- a/audio/core/all-versions/default/include/core/all-versions/default/StreamIn.impl.h
+++ b/audio/core/all-versions/default/include/core/all-versions/default/StreamIn.impl.h
@@ -20,6 +20,7 @@
 #define ATRACE_TAG ATRACE_TAG_AUDIO
 
 #include <android/log.h>
+#include <cutils/properties.h>
 #include <hardware/audio.h>
 #include <utils/Trace.h>
 #include <memory>
@@ -426,6 +427,12 @@ Result StreamIn::getCapturePositionImpl(audio_stream_in_t* stream, uint64_t* fra
     static const std::vector<int> ignoredErrors{ENOSYS};
     Result retval(Result::NOT_SUPPORTED);
     if (stream->get_capture_position == NULL) return retval;
+    // Some legacy HALs never assign get_capture_position, so the slot holds
+    // uninitialised memory and the NULL check above does not catch it. Such
+    // devices set ro.audio.legacy_hal_no_capture_position.
+    static const bool capturePositionBroken =
+        property_get_bool("ro.audio.legacy_hal_no_capture_position", false);
+    if (capturePositionBroken) return retval;
     int64_t halFrames, halTime;
     retval = Stream::analyzeStatus("get_capture_position",
                                    stream->get_capture_position(stream, &halFrames, &halTime),
