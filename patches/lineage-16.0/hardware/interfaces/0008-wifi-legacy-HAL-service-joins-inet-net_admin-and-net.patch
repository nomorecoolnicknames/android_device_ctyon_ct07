From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:57:42 +0300
Subject: [PATCH 8/8] wifi: legacy HAL service joins inet, net_admin and
 net_raw

On kernels built with CONFIG_ANDROID_PARANOID_NETWORK an AF_INET socket
needs membership in inet. Without it the HAL cannot bring the interface
up ("Failed to open socket to set up/down state (Permission denied)")
and Wi-Fi never starts. net_admin and net_raw are gated the same way.
---
 wifi/1.2/default/android.hardware.wifi@1.0-service.rc | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/wifi/1.2/default/android.hardware.wifi@1.0-service.rc b/wifi/1.2/default/android.hardware.wifi@1.0-service.rc
index cf849d0..73f2c34 100644
--- a/wifi/1.2/default/android.hardware.wifi@1.0-service.rc
+++ b/wifi/1.2/default/android.hardware.wifi@1.0-service.rc
@@ -2,4 +2,6 @@ service vendor.wifi_hal_legacy /vendor/bin/hw/android.hardware.wifi@1.0-service
     class hal
     capabilities NET_ADMIN NET_RAW SYS_MODULE
     user wifi
-    group wifi gps
+    # Kernels with CONFIG_ANDROID_PARANOID_NETWORK need inet for AF_INET
+    # sockets (and net_admin/net_raw likewise).
+    group wifi gps inet net_admin net_raw
