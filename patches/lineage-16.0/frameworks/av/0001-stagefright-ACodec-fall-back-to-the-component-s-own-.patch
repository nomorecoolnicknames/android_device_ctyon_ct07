From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:57:42 +0300
Subject: [PATCH 1/3] stagefright: ACodec: fall back to the component's own
 buffer count

Some vendor video decoders (MediaTek among them) report a small
nBufferCountMin but reject every nBufferCountActual below the count they
computed themselves and returned in the same port definition. When all
the counts ACodec offers are refused, try that count before giving up;
otherwise such a decoder never leaves the Loaded state.
---
 media/libstagefright/ACodec.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/media/libstagefright/ACodec.cpp b/media/libstagefright/ACodec.cpp
index 014dfa9..3b93078 100644
--- a/media/libstagefright/ACodec.cpp
+++ b/media/libstagefright/ACodec.cpp
@@ -1128,6 +1128,13 @@ status_t ACodec::configureOutputBuffersFromNativeWindow(
     status_t err = mOMXNode->getParameter(
             OMX_IndexParamPortDefinition, &def, sizeof(def));
 
+    // Some vendor components -- the MediaTek video decoders among them --
+    // report a tiny nBufferCountMin but then reject every nBufferCountActual
+    // below the count they worked out for themselves and handed back in this
+    // very struct.  Keep that count so the negotiation below has something to
+    // fall back on once the conservative guesses have all been refused.
+    const OMX_U32 componentBufferCount = def.nBufferCountActual;
+
     if (err == OK) {
         err = setupNativeWindowSizeFormatAndUsage(
                 mNativeWindow.get(), &mNativeWindowUsageBits,
@@ -1192,6 +1199,20 @@ status_t ACodec::configureOutputBuffersFromNativeWindow(
                 mComponentName.c_str(), newBufferCount, err);
         /* exit condition */
         if (extraBuffers == 0) {
+            // Everything we offered was refused.  Ask for exactly what the
+            // component reported it wanted before giving up -- without this a
+            // decoder that needs more buffers than nBufferCountMin suggests
+            // can never leave the Loaded state.
+            if (componentBufferCount > newBufferCount) {
+                def.nBufferCountActual = componentBufferCount;
+                if (mOMXNode->setParameter(
+                            OMX_IndexParamPortDefinition, &def, sizeof(def)) == OK) {
+                    ALOGI("[%s] falling back to the component's own "
+                            "nBufferCountActual %u",
+                            mComponentName.c_str(), componentBufferCount);
+                    break;
+                }
+            }
             return err;
         }
     }
