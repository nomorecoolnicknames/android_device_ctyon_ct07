     }
 
+    /**
+     * Returns the stack scroll at which the given task is the focused task. The low-RAM layout
+     * scrolls in its own units, not in task indices (see
+     * TaskStackLowRamLayoutAlgorithm.getScrollPForTask()); the touch handler converts the same way.
+     */
+    float getStackScrollForFocusedTask(Task t) {
+        float scroll = getStackScrollForTask(t);
+        if (Recents.getConfiguration().isLowRamDevice) {
+            scroll = mTaskStackLowRamLayoutAlgorithm.getScrollPForTask((int) scroll);
+        }
+        return scroll;
+    }
