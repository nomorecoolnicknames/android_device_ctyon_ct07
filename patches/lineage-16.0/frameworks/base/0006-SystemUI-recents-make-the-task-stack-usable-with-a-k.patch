+    @Override
+    public boolean dispatchKeyEvent(KeyEvent event) {
+        // OK opens the focused task when released and dismisses it when held (keypad phones
+        // without a touch panel). Take it before the focused task view, which would click on
+        // every press and knows no long press.
+        final int keyCode = event.getKeyCode();
+        if (keyCode == KeyEvent.KEYCODE_DPAD_CENTER || keyCode == KeyEvent.KEYCODE_ENTER) {
+            onUserInteraction();
+            return event.dispatch(this, getWindow().getDecorView().getKeyDispatcherState(), this);
+        }
+        return super.dispatchKeyEvent(event);
+    }
+
     @Override
     public boolean onKeyDown(int keyCode, KeyEvent event) {
         switch (keyCode) {
+            case KeyEvent.KEYCODE_DPAD_CENTER:
+            case KeyEvent.KEYCODE_ENTER:
+                event.startTracking();
+                return true;
             case KeyEvent.KEYCODE_TAB: {
                 int altTabKeyDelay = getResources().getInteger(R.integer.recents_alt_tab_key_delay);
                 boolean hasRepKeyTimeElapsed = (SystemClock.elapsedRealtime() -
@@ -642,6 +659,27 @@ public class RecentsActivity extends Activity implements ViewTreeObserver.OnPreD
         return super.onKeyDown(keyCode, event);
     }
 
+    @Override
+    public boolean onKeyLongPress(int keyCode, KeyEvent event) {
+        if (keyCode == KeyEvent.KEYCODE_DPAD_CENTER || keyCode == KeyEvent.KEYCODE_ENTER) {
+            EventBus.getDefault().send(new DismissFocusedTaskViewEvent());
+            return true;
+        }
+        return super.onKeyLongPress(keyCode, event);
+    }
+
+    @Override
+    public boolean onKeyUp(int keyCode, KeyEvent event) {
+        if (keyCode == KeyEvent.KEYCODE_DPAD_CENTER || keyCode == KeyEvent.KEYCODE_ENTER) {
+            // A handled long press cancels the up.
+            if (event.isTracking() && !event.isCanceled()) {
+                mRecentsView.launchFocusedTask(0 /* logEvent */);
+            }
+            return true;
+        }
+        return super.onKeyUp(keyCode, event);
+    }
+
