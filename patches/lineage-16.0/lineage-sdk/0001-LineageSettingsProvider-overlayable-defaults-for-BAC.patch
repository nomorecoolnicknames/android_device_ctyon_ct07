From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 24 Sep 2026 15:51:07 +0300
Subject: [PATCH] LineageSettingsProvider: overlayable defaults for
 BACK/MENU_WAKE_SCREEN

First-boot defaults for LineageSettings.System.BACK_WAKE_SCREEN and
MENU_WAKE_SCREEN, false as before. PhoneWindowManager lets BACK and MENU
wake the screen only when the setting is 1 and the key is in
config_deviceHardwareWakeKeys, so a device whose soft keys should wake it
out of the box (a keypad phone without a power button) needs both from
its overlays.
---
 packages/LineageSettingsProvider/res/values/defaults.xml    | 5 +++++
 .../lineageos/lineagesettings/LineageDatabaseHelper.java    | 6 ++++++
 2 files changed, 11 insertions(+)

diff --git a/packages/LineageSettingsProvider/res/values/defaults.xml b/packages/LineageSettingsProvider/res/values/defaults.xml
index a877c14..83e1a44 100644
--- a/packages/LineageSettingsProvider/res/values/defaults.xml
+++ b/packages/LineageSettingsProvider/res/values/defaults.xml
@@ -99,6 +99,11 @@
     <!-- Default value for swapping volume keys on rotation -->
     <bool name="def_swap_volume_keys_on_rotation">false</bool>
 
+    <!-- Defaults for LineageSettings.System.BACK_WAKE_SCREEN and MENU_WAKE_SCREEN.
+         They only take effect for keys that config_deviceHardwareWakeKeys lists. -->
+    <bool name="def_back_wake_screen">false</bool>
+    <bool name="def_menu_wake_screen">false</bool>
+
     <!-- Default values for protected component managers -->
     <string name="def_protected_component_managers" translatable="false">com.android.settings|com.android.launcher3|org.lineageos.trebuchet|org.lineageos.lineageparts</string>
 
diff --git a/packages/LineageSettingsProvider/src/org/lineageos/lineagesettings/LineageDatabaseHelper.java b/packages/LineageSettingsProvider/src/org/lineageos/lineagesettings/LineageDatabaseHelper.java
index 670b402..facb431 100644
--- a/packages/LineageSettingsProvider/src/org/lineageos/lineagesettings/LineageDatabaseHelper.java
+++ b/packages/LineageSettingsProvider/src/org/lineageos/lineagesettings/LineageDatabaseHelper.java
@@ -559,6 +559,12 @@ public class LineageDatabaseHelper extends SQLiteOpenHelper{
             loadBooleanSetting(stmt, LineageSettings.System.SWAP_VOLUME_KEYS_ON_ROTATION,
                     R.bool.def_swap_volume_keys_on_rotation);
 
+            loadBooleanSetting(stmt, LineageSettings.System.BACK_WAKE_SCREEN,
+                    R.bool.def_back_wake_screen);
+
+            loadBooleanSetting(stmt, LineageSettings.System.MENU_WAKE_SCREEN,
+                    R.bool.def_menu_wake_screen);
+
             loadIntegerSetting(stmt, LineageSettings.System.STATUS_BAR_BATTERY_STYLE,
                     R.integer.def_battery_style);
 
