From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Thu, 24 Sep 2026 15:56:51 +0300
Subject: [PATCH 2/2] Dialer: let the D-pad leave the main layout on devices
 without a touchscreen

dialtacts_mainlayout is focusable so that the search box does not take
the focus, and bring up an input method, on start. Without a touchscreen
it then kept the focus: it covers the whole window, so no D-pad key found
a view in its direction. With Configuration.TOUCHSCREEN_NOTOUCH the
layout now gives the focus to its children first.
---
 java/com/android/dialer/app/DialtactsActivity.java | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/java/com/android/dialer/app/DialtactsActivity.java b/java/com/android/dialer/app/DialtactsActivity.java
index b3d995c..04b5bef 100644
--- a/java/com/android/dialer/app/DialtactsActivity.java
+++ b/java/com/android/dialer/app/DialtactsActivity.java
@@ -56,6 +56,7 @@ import android.view.MenuItem;
 import android.view.MotionEvent;
 import android.view.View;
 import android.view.View.OnDragListener;
+import android.view.ViewGroup;
 import android.view.animation.Animation;
 import android.view.animation.AnimationUtils;
 import android.widget.AbsListView.OnScrollListener;
@@ -482,6 +483,12 @@ public class DialtactsActivity extends TransactionSafeActivity
 
     parentLayout = (CoordinatorLayout) findViewById(R.id.dialtacts_mainlayout);
     parentLayout.setOnDragListener(new LayoutOnDragListener());
+    // The main layout is focusable so that the search box does not take the focus (and show an
+    // input method) on start. Without a touch panel it then kept the focus: it covers the whole
+    // window, so no D-pad key could move to the tabs, the lists or the dialpad button.
+    if (getResources().getConfiguration().touchscreen == Configuration.TOUCHSCREEN_NOTOUCH) {
+      parentLayout.setDescendantFocusability(ViewGroup.FOCUS_AFTER_DESCENDANTS);
+    }
     ViewUtil.doOnGlobalLayout(
         floatingActionButton,
         view -> {
