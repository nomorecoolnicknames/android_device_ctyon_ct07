From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Wed, 2 Sep 2026 13:50:39 +0300
Subject: [PATCH] wifi: retry the driver state control write

Try the open and write of WIFI_DRIVER_STATE_CTRL_PARAM up to
WIFI_DRIVER_STATE_CTRL_RETRIES times, WIFI_DRIVER_STATE_CTRL_RETRY_DELAY_US
apart. Both are BoardConfig variables; the default is a single attempt,
as before.

The Ctyon CT07 (MT6737T, /dev/wmtWifi) uses 8 attempts, 1 s apart.
---
 wifi/Android.mk |  6 ++++++
 wifi/wifi.c     | 43 +++++++++++++++++++++++++++++++------------
 2 files changed, 37 insertions(+), 12 deletions(-)

diff --git a/wifi/Android.mk b/wifi/Android.mk
index dbac36e..b05aab7 100644
--- a/wifi/Android.mk
+++ b/wifi/Android.mk
@@ -40,6 +40,12 @@ endif
 ifdef WIFI_DRIVER_STATE_CTRL_PARAM
 LOCAL_CFLAGS += -DWIFI_DRIVER_STATE_CTRL_PARAM=\"$(WIFI_DRIVER_STATE_CTRL_PARAM)\"
 endif
+ifdef WIFI_DRIVER_STATE_CTRL_RETRIES
+LOCAL_CFLAGS += -DWIFI_DRIVER_STATE_CTRL_RETRIES=$(WIFI_DRIVER_STATE_CTRL_RETRIES)
+endif
+ifdef WIFI_DRIVER_STATE_CTRL_RETRY_DELAY_US
+LOCAL_CFLAGS += -DWIFI_DRIVER_STATE_CTRL_RETRY_DELAY_US=$(WIFI_DRIVER_STATE_CTRL_RETRY_DELAY_US)
+endif
 ifdef WIFI_DRIVER_STATE_ON
 LOCAL_CFLAGS += -DWIFI_DRIVER_STATE_ON=\"$(WIFI_DRIVER_STATE_ON)\"
 endif
diff --git a/wifi/wifi.c b/wifi/wifi.c
index de2f8ee..d6422bf 100644
--- a/wifi/wifi.c
+++ b/wifi/wifi.c
@@ -292,26 +292,45 @@ const char *get_dhcp_error_string() {
 }
 
 #ifdef WIFI_DRIVER_STATE_CTRL_PARAM
+#ifndef WIFI_DRIVER_STATE_CTRL_RETRIES
+#define WIFI_DRIVER_STATE_CTRL_RETRIES 1
+#endif
+#ifndef WIFI_DRIVER_STATE_CTRL_RETRY_DELAY_US
+#define WIFI_DRIVER_STATE_CTRL_RETRY_DELAY_US 500000
+#endif
+
 int wifi_change_driver_state(const char *state)
 {
+    int attempt;
     int len;
     int fd;
-    int ret = 0;
 
     if (!state)
         return -1;
-    fd = TEMP_FAILURE_RETRY(open(WIFI_DRIVER_STATE_CTRL_PARAM, O_WRONLY));
-    if (fd < 0) {
-        ALOGE("Failed to open driver state control param (%s)", strerror(errno));
-        return -1;
-    }
-    len = strlen(state) + 1;
-    if (TEMP_FAILURE_RETRY(write(fd, state, len)) != len) {
-        ALOGE("Failed to write driver state control param (%s)", strerror(errno));
-        ret = -1;
+
+    for (attempt = 0; attempt < WIFI_DRIVER_STATE_CTRL_RETRIES; attempt++) {
+        if (attempt > 0)
+            usleep(WIFI_DRIVER_STATE_CTRL_RETRY_DELAY_US);
+
+        fd = TEMP_FAILURE_RETRY(open(WIFI_DRIVER_STATE_CTRL_PARAM, O_WRONLY));
+        if (fd < 0) {
+            ALOGE("Failed to open driver state control param, attempt %d/%d (%s)",
+                  attempt + 1, WIFI_DRIVER_STATE_CTRL_RETRIES, strerror(errno));
+            continue;
+        }
+
+        len = strlen(state) + 1;
+        if (TEMP_FAILURE_RETRY(write(fd, state, len)) == len) {
+            close(fd);
+            return 0;
+        }
+
+        ALOGE("Failed to write driver state control param, attempt %d/%d (%s)",
+              attempt + 1, WIFI_DRIVER_STATE_CTRL_RETRIES, strerror(errno));
+        close(fd);
     }
-    close(fd);
-    return ret;
+
+    return -1;
 }
 #endif
 
