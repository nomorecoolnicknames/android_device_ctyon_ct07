From 140e724f9eb02843285c8af5eaaa44fc42899a9d Mon Sep 17 00:00:00 2001
From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Fri, 25 Sep 2026 22:52:02 +0300
Subject: [PATCH] mediaserver: no neverallowxperm for privileged socket ioctls

The MediaTek patch set comments this rule out together with the
allowxperm above it, but its second mediaserver.te hunk does not apply
to cm-14.1, and the MediaTek media rules then fail the policy build.
---
 mediaserver.te | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mediaserver.te b/mediaserver.te
index 8e1bdee..519b87f 100644
--- a/mediaserver.te
+++ b/mediaserver.te
@@ -138,4 +138,4 @@ allow mediaserver preloads_data_file:file { getattr read ioctl };
 neverallow mediaserver { file_type fs_type }:file execute_no_trans;
 
 # do not allow privileged socket ioctl commands
-neverallowxperm mediaserver domain:{ rawip_socket tcp_socket udp_socket } ioctl priv_sock_ioctls;
+#neverallowxperm mediaserver domain:{ rawip_socket tcp_socket udp_socket } ioctl priv_sock_ioctls;
-- 
2.39.5

