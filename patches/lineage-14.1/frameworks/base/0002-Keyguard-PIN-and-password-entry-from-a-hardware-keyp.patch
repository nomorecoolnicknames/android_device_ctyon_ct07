From: nomorecoolnicknames <nomorecoolnicknames@users.noreply.github.com>
Date: Mon, 28 Sep 2026 16:35:09 +0300
Subject: [PATCH] Keyguard: PIN and password entry from a hardware keypad

On a keypad phone without a touchscreen the bouncer could keep the user
out:

- An arrow key moved the focus from the PIN field to a pad button. From
  there the digits went nowhere (only the PIN field listens for them),
  and OK clicked the focused button instead of confirming. Without a
  touchscreen the pad buttons now stay out of the D-pad focus, and the
  digits and delete bring the focus back to the PIN field from anywhere
  else (the emergency call button, where OK still calls).
- With the PIN layout scrambled, a digit key clicked the button with id
  keyN, which then shows another digit. A digit key now types its digit.
- Without a DEL key a digit could not be deleted. BACK now deletes the
  last digit (held, it keeps deleting) and closes the bouncer only when
  the PIN is empty.
- In the password bouncer OK (DPAD_CENTER) did nothing unless the IME
  turned it into an editor action: TextView does that only for ENTER.
  OK that no IME handled now verifies the password.
- The password field asks the IME for English. Settings accepts only
  ASCII passwords, but a T9 IME keeps the last used language and would
  type e.g. Cyrillic here, hidden behind the dots.
---
 .../keyguard/KeyguardPasswordView.java        | 20 +++++
 .../keyguard/KeyguardPinBasedInputView.java   | 83 ++++++++++++-------
 2 files changed, 72 insertions(+), 31 deletions(-)

diff --git a/packages/Keyguard/src/com/android/keyguard/KeyguardPasswordView.java b/packages/Keyguard/src/com/android/keyguard/KeyguardPasswordView.java
index 22bdbaf..b467c15 100644
--- a/packages/Keyguard/src/com/android/keyguard/KeyguardPasswordView.java
+++ b/packages/Keyguard/src/com/android/keyguard/KeyguardPasswordView.java
@@ -18,6 +18,7 @@ package com.android.keyguard;
 
 import android.content.Context;
 import android.graphics.Rect;
+import android.os.LocaleList;
 import android.text.Editable;
 import android.text.InputType;
 import android.text.TextUtils;
@@ -39,6 +40,7 @@ import com.android.internal.widget.TextViewInputDisabler;
 import com.android.keyguard.KeyguardSecurityModel.SecurityMode;
 
 import java.util.List;
+import java.util.Locale;
 /**
  * Displays an alphanumeric (latin-1) key entry for the user to enter
  * an unlock password
@@ -184,6 +186,24 @@ public class KeyguardPasswordView extends KeyguardAbsKeyInputView
                 | InputType.TYPE_TEXT_VARIATION_PASSWORD);
         mPasswordEntry.setOnEditorActionListener(this);
         mPasswordEntry.addTextChangedListener(this);
+        // OK on a hardware keypad is DPAD_CENTER, which TextView never turns into an editor
+        // action. An IME that handles OK sends the action itself; if none did, verify here.
+        mPasswordEntry.setOnKeyListener(new OnKeyListener() {
+            @Override
+            public boolean onKey(View v, int keyCode, KeyEvent event) {
+                if (keyCode != KeyEvent.KEYCODE_DPAD_CENTER) {
+                    return false;
+                }
+                if (event.getAction() == KeyEvent.ACTION_DOWN && event.getRepeatCount() == 0) {
+                    verifyPasswordAndUnlock();
+                }
+                return true;
+            }
+        });
+        // Passwords can only be set in ASCII, so ask the IME for English letters. An IME that
+        // remembers the last language (T9 on keypad phones) would otherwise type e.g. Cyrillic
+        // here, behind the dots.
+        mPasswordEntry.setImeHintLocales(new LocaleList(Locale.ENGLISH));
 
         // Poke the wakelock any time the text is selected or modified
         mPasswordEntry.setOnClickListener(new OnClickListener() {
diff --git a/packages/Keyguard/src/com/android/keyguard/KeyguardPinBasedInputView.java b/packages/Keyguard/src/com/android/keyguard/KeyguardPinBasedInputView.java
index 108b466..6062f2b 100644
--- a/packages/Keyguard/src/com/android/keyguard/KeyguardPinBasedInputView.java
+++ b/packages/Keyguard/src/com/android/keyguard/KeyguardPinBasedInputView.java
@@ -17,6 +17,7 @@
 package com.android.keyguard;
 
 import android.content.Context;
+import android.content.res.Configuration;
 import android.graphics.Rect;
 import android.util.AttributeSet;
 import android.view.KeyEvent;
@@ -42,6 +43,7 @@ public abstract class KeyguardPinBasedInputView extends KeyguardAbsKeyInputView
     private View mButton7;
     private View mButton8;
     private View mButton9;
+    private boolean mBackDeleting;
 
     public KeyguardPinBasedInputView(Context context) {
         this(context, null);
@@ -80,6 +82,25 @@ public abstract class KeyguardPinBasedInputView extends KeyguardAbsKeyInputView
         mOkButton.setEnabled(enabled);
     }
 
+    @Override
+    public boolean dispatchKeyEvent(KeyEvent event) {
+        // Digits and delete belong to the PIN even when the D-pad has moved the focus elsewhere
+        // (e.g. to the emergency call button): give the focus back to the PIN before the key.
+        if (!mPasswordEntry.isFocused() && isPinEditKey(event)) {
+            mPasswordEntry.requestFocus();
+        }
+        return super.dispatchKeyEvent(event);
+    }
+
+    private boolean isPinEditKey(KeyEvent event) {
+        final int keyCode = event.getKeyCode();
+        return (keyCode >= KeyEvent.KEYCODE_0 && keyCode <= KeyEvent.KEYCODE_9)
+                || (keyCode >= KeyEvent.KEYCODE_NUMPAD_0 && keyCode <= KeyEvent.KEYCODE_NUMPAD_9)
+                || keyCode == KeyEvent.KEYCODE_DEL
+                || (keyCode == KeyEvent.KEYCODE_BACK && event.getAction() == KeyEvent.ACTION_DOWN
+                        && mPasswordEntry.getText().length() > 0);
+    }
+
     @Override
     public boolean onKeyDown(int keyCode, KeyEvent event) {
         if (KeyEvent.isConfirmKey(keyCode)) {
@@ -88,6 +109,16 @@ public abstract class KeyguardPinBasedInputView extends KeyguardAbsKeyInputView
         } else if (keyCode == KeyEvent.KEYCODE_DEL) {
             performClick(mDeleteButton);
             return true;
+        } else if (keyCode == KeyEvent.KEYCODE_BACK) {
+            // A keypad without a delete key: BACK deletes the last digit, and closes the
+            // bouncer only when there is nothing left to delete. Held, it keeps deleting.
+            if (event.getRepeatCount() == 0) {
+                mBackDeleting = mPasswordEntry.getText().length() > 0;
+            }
+            if (mBackDeleting) {
+                performClick(mDeleteButton);
+                return true;
+            }
         }
         if (keyCode >= KeyEvent.KEYCODE_0 && keyCode <= KeyEvent.KEYCODE_9) {
             int number = keyCode - KeyEvent.KEYCODE_0;
@@ -125,37 +156,10 @@ public abstract class KeyguardPinBasedInputView extends KeyguardAbsKeyInputView
     }
 
     private void performNumberClick(int number) {
-        switch (number) {
-            case 0:
-                performClick(mButton0);
-                break;
-            case 1:
-                performClick(mButton1);
-                break;
-            case 2:
-                performClick(mButton2);
-                break;
-            case 3:
-                performClick(mButton3);
-                break;
-            case 4:
-                performClick(mButton4);
-                break;
-            case 5:
-                performClick(mButton5);
-                break;
-            case 6:
-                performClick(mButton6);
-                break;
-            case 7:
-                performClick(mButton7);
-                break;
-            case 8:
-                performClick(mButton8);
-                break;
-            case 9:
-                performClick(mButton9);
-                break;
+        // Type the digit of the key, as a click on a pad button would. The button with id keyN
+        // shows another digit when the PIN layout is scrambled, so do not click it.
+        if (mPasswordEntry.isEnabled()) {
+            mPasswordEntry.append(Character.forDigit(number, 10));
         }
     }
 
@@ -233,6 +237,18 @@ public abstract class KeyguardPinBasedInputView extends KeyguardAbsKeyInputView
         mButton8 = findViewById(R.id.key8);
         mButton9 = findViewById(R.id.key9);
 
+        // Without a touchscreen the keypad has keys of its own for the digits, OK and delete.
+        // Keep the pad buttons out of the D-pad focus: an arrow press would move the focus off
+        // the PIN, and OK would then click a pad button instead of confirming.
+        if (getResources().getConfiguration().touchscreen == Configuration.TOUCHSCREEN_NOTOUCH) {
+            for (View key : new View[] { mOkButton, mDeleteButton, mButton0, mButton1, mButton2,
+                    mButton3, mButton4, mButton5, mButton6, mButton7, mButton8, mButton9 }) {
+                if (key != null) {
+                    key.setFocusable(false);
+                }
+            }
+        }
+
         mPasswordEntry.requestFocus();
         super.onFinishInflate();
     }
@@ -250,6 +266,11 @@ public abstract class KeyguardPinBasedInputView extends KeyguardAbsKeyInputView
         if (event.getAction() == KeyEvent.ACTION_DOWN) {
             return onKeyDown(keyCode, event);
         }
+        if (keyCode == KeyEvent.KEYCODE_BACK && mBackDeleting) {
+            // The UP of a BACK that deleted must not close the bouncer as well.
+            mBackDeleting = false;
+            return true;
+        }
         return false;
     }
 }
