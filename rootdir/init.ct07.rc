# CT07 additions to the stock MT6735 rc files for Android 9.
# Imported from init.mt6735.rc.

# adb over FunctionFS on the legacy android_usb gadget (there is no configfs
# gadget). Pie's init.usb.rc no longer mounts functionfs for it.
on early-init
    setprop sys.usb.configfs 0

on init
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/f_ffs/aliases adb

# adb as soon as /system is mounted.
on post-fs
    setprop sys.usb.config adb

# Wi-Fi: HIDL supplicant
on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/misc/wifi 0770 wifi wifi

# /dev/wmtWifi and /dev/stpbt exist once wmt_loader has probed the combo chip.
on property:init.svc.wmtLoader=stopped
    chown wifi system /dev/wmtWifi
    chmod 0660 /dev/wmtWifi
    chown bluetooth bluetooth /dev/stpbt
    chmod 0660 /dev/stpbt

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    group system wifi inet
    disabled
    oneshot

# Telephony: MTK HIDL rild (vendor/mediatek/ril) with the stock mtk-ril.so.
# ril.muxreport=0 keeps libril from resetting the modem on the first
# command connection.
on post-fs-data
    setprop ril.muxreport 0
    chown radio radio /dev/ttyC0
    chown radio radio /dev/ccci_fs
    chown radio radio /dev/ccci_ioctl0
    chown radio radio /dev/ccci_monitor
    chown media audio /dev/ccci_aud

on property:mtk.md1.status=ready
    chown radio radio /dev/ttyC0
    start gsm0710muxd

on property:init.svc.gsm0710muxd=running
    start ril-daemon-mtk

service ril-daemon-mtk /vendor/bin/hw/rild
    class main
    socket rild stream 660 root radio
    socket rild2 stream 660 root radio
    socket rild3 stream 660 root radio
    socket rild4 stream 660 root radio
    socket rild-debug stream 660 radio system
    socket rild-oem stream 660 radio system
    socket rild-mtk-ut stream 660 radio net_bt
    socket rild-mtk-ut-2 stream 660 radio net_bt
    socket rild-mtk-modem stream 660 radio system
    socket rild-atci stream 660 root radio
    socket sap_uim_socket1 stream 660 bluetooth bluetooth
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot
