# zram swap (fstab.mt6735). lz4k has to be selected before swapon_all sets
# the disk size.
on property:sys.boot_completed=1
    write /sys/block/zram0/comp_algorithm lz4k
    swapon_all /fstab.mt6735
    write /proc/sys/vm/swappiness 100
    # zram pages are decompressed one at a time; readahead only costs CPU.
    write /proc/sys/vm/page-cluster 0
    # perfprofd (userdebug, debug tag) profiles nothing without a config.
    stop perfprofd
